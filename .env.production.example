# Cấu hình Chung
APP_PORT=3000
SECRET_KEY=generate_a_random_secure_secret_key_here_for_production
DOMAIN_NAME=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ORIGIN=http://localhost:3000
PUBLIC_DJANGO_API_URL=http://localhost:8000

# PostgreSQL Database
DBNAME=crm_db
DBUSER=postgres
DBPASSWORD=postgres123_secure
DBHOST=db
DBPORT=5432

# Redis & Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Cấu hình SMTP Gửi Báo Giá & Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@smecrm.vn
ADMIN_EMAIL=admin@smecrm.vn
